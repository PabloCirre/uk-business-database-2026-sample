          },
          {
            "name": "Direct_UK_Telephone",
            "type": "string",
            "description": "TPS-screened corporate switchboard telephone number"
          },
          {
            "name": "Company_Website_URL",
            "type": "string",
            "format": "uri",
            "description": "Corporate website URL"
          },
          {
            "name": "Employee_Size_Band",
            "type": "string",
            "description": "Estimated employee headcount band"
          },
          {
            "name": "Turnover_Band_GBP",
